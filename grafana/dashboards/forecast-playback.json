          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT issued_at AS time, 'issued' AS text FROM forecasts WHERE id = ${forecast_id}\nUNION ALL\nSELECT newest_observation_at, 'newest observation used' FROM forecasts WHERE id = ${forecast_id}"
