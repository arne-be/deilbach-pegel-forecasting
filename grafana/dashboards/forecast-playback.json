{
  "uid": "deilbach-forecast-playback",
  "title": "Forecast playback",
  "description": "Past forecasts against what happened. Managed in git (grafana/dashboards/); edits in the UI are overwritten on the next deploy.",
  "tags": [
    "deilbach-pegel"
  ],
  "timezone": "Europe/Berlin",
  "refresh": "",
  "time": {
    "from": "now-24h",
    "to": "now+24h"
  },
  "editable": true,
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "hide": 2,
        "current": {}
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "sort": 0,
        "current": {},
        "definition": "SELECT model FROM forecasts GROUP BY model ORDER BY model = 'persistence', model",
        "query": "SELECT model FROM forecasts GROUP BY model ORDER BY model = 'persistence', model"
      },
      {
        "name": "forecast_id",
        "label": "Shown forecast",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 0,
        "current": {},
        "definition": "SELECT id AS __value, coalesce(to_char(issued_at AT TIME ZONE 'Europe/Berlin', 'DD.MM.YYYY HH24:MI'), 'none') AS __text\nFROM (\n  SELECT id, issued_at FROM forecasts WHERE model = '${model}' AND issued_at <= $__timeFrom()::timestamptz + ($__timeTo()::timestamptz - $__timeFrom()::timestamptz) / 2\n  UNION ALL SELECT -1, NULL\n) f\nORDER BY issued_at DESC NULLS LAST\nLIMIT 1",
        "query": "SELECT id AS __value, coalesce(to_char(issued_at AT TIME ZONE 'Europe/Berlin', 'DD.MM.YYYY HH24:MI'), 'none') AS __text\nFROM (\n  SELECT id, issued_at FROM forecasts WHERE model = '${model}' AND issued_at <= $__timeFrom()::timestamptz + ($__timeTo()::timestamptz - $__timeFrom()::timestamptz) / 2\n  UNION ALL SELECT -1, NULL\n) f\nORDER BY issued_at DESC NULLS LAST\nLIMIT 1"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Shown forecast",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "filter": {
          "exclude": false,
          "ids": [
            1
          ]
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT issued_at AS time, 'issued' AS text FROM forecasts WHERE id = ${forecast_id}\nUNION ALL\nSELECT newest_observation_at, 'newest observation used' FROM forecasts WHERE id = ${forecast_id}"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Playback: newest forecast at the middle of the time range",
      "description": "The newest forecast of the chosen model issued before the middle of the time range, with its bands, and the cleaned level observed around it. Step through time with the time picker's shift arrows (half a range per click) or by zooming; the variable 'Shown forecast' names its issue time. The vertical markers are its issue time and its newest observation.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
