      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT o.valid_at AS time, 'observed (cleaned)' AS metric, o.value\nFROM observations o\nWHERE o.series_id IN (SELECT DISTINCT station_id || ':cleaned_kalman' FROM forecasts WHERE model = '${model}')\n  AND $__timeFilter(o.valid_at)\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT * FROM (\n  -- one point per forecast and lead; persistence points don't sit on whole hours\n  SELECT DISTINCT ON (f.id, l.hours) p.valid_at AS time, l.hours || ' h ahead' AS metric, p.level_cm AS value\n  FROM forecasts f\n  JOIN forecast_points p ON p.forecast_id = f.id\n  CROSS JOIN LATERAL (SELECT round(extract(epoch FROM p.valid_at - f.issued_at) / 3600)::int AS hours) l\n  WHERE f.model = '${model}' AND l.hours IN (${lead:csv})\n    AND f.issued_at BETWEEN $__timeFrom()::timestamptz - interval '25 hours' AND $__timeTo()\n    AND $__timeFilter(p.valid_at)\n  ORDER BY f.id, l.hours, abs(extract(epoch FROM p.valid_at - f.issued_at) - l.hours * 3600)\n) s\nORDER BY time"
        }
      ]
