{
  "uid": "deilbach-all-series",
  "title": "All series",
  "description": "Every time series in the prod database. Managed in git (grafana/dashboards/); edits in the UI are overwritten on the next deploy.",
  "tags": [
    "deilbach-pegel"
  ],
  "timezone": "Europe/Berlin",
  "refresh": "",
  "time": {
    "from": "now-7d",
    "to": "now+2d"
  },
  "editable": true,
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Forecast station: observed, newest forecast and its bands",
      "description": "Raw and cleaned level at every station we forecast, the newest forecast of each model with its situation tag, and its uncertainty bands (80, 90, 95 %) where it has them. Band series aren't named per model: fine while only the configured model has bands.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthcm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": 10800000,
            "showPoints": "never"
          }
        },
