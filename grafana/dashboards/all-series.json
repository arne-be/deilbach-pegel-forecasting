      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(o.valid_at, $__interval), o.series_id AS metric, avg(o.value) AS value\nFROM observations o\nJOIN series s ON s.id = o.series_id\nWHERE s.variable = 'level' AND s.location IN (SELECT DISTINCT station_id FROM forecasts)\n  AND $__timeFilter(o.valid_at)\nGROUP BY 1, 2\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT p.valid_at AS time,\n  'forecast:' || f.model || coalesce(' (' || f.situation || ')', '') AS metric,\n  p.level_cm AS value\nFROM forecast_points p\nJOIN (\n  SELECT DISTINCT ON (station_id, model) id, model, situation\n  FROM forecasts\n  ORDER BY station_id, model, issued_at DESC\n) f ON f.id = p.forecast_id\nORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT b.valid_at AS time, b.coverage_percent || ' % ' || edge.name AS metric, edge.value\nFROM forecast_bands b\nJOIN (\n  SELECT DISTINCT ON (station_id, model) id\n  FROM forecasts\n  ORDER BY station_id, model, issued_at DESC\n) f ON f.id = b.forecast_id\nCROSS JOIN LATERAL (VALUES ('lower', b.lower_cm), ('upper', b.upper_cm)) AS edge (name, value)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "All gauge levels",
      "description": "Every observed level series, averaged per pixel.",
      "datasource": {
