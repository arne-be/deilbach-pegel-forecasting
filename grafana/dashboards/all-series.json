            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(o.valid_at, $__interval), o.series_id AS metric, avg(o.value) AS value\nFROM observations o\nJOIN series s ON s.id = o.series_id\nWHERE s.variable = 'level' AND $__timeFilter(o.valid_at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
    {
