    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Input forecasts, newest run per hour",
      "description": "Forecasts from others that the model uses, e.g. ICON-D2 rain. For each hour the value from the newest run.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthmm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": 10800000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(valid_at, $__interval), series_id AS metric, avg(value) AS value\nFROM (\n  SELECT DISTINCT ON (series_id, valid_at) series_id, valid_at, value\n  FROM input_forecasts\n  WHERE $__timeFilter(valid_at)\n  ORDER BY series_id, valid_at, run_at DESC\n) newest\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Freshness",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "description": "Newest value of every series and of our own forecasts. Ignores the time picker.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT s.id AS \"Series\", coalesce(o.at, f.at) AS \"Newest\",\n  extract(epoch FROM now() - coalesce(o.at, f.at)) AS \"Age\"\nFROM series s\nLEFT JOIN LATERAL (\n  SELECT valid_at AS at FROM observations WHERE series_id = s.id ORDER BY valid_at DESC LIMIT 1\n) o ON true\nLEFT JOIN LATERAL (\n  SELECT run_at AS at FROM input_forecasts WHERE series_id = s.id ORDER BY run_at DESC LIMIT 1\n) f ON true\nUNION ALL\nSELECT 'forecast:' || station_id || ':' || model, max(issued_at), extract(epoch FROM now() - max(issued_at))\nFROM forecasts\nGROUP BY station_id, model\nORDER BY 3 DESC"
        }
      ]
    }
  ],
