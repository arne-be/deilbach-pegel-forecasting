# Template for local configuration. Copy to .env and .env.local:
#   cp .env.example .env         # connection settings
#   touch .env.local             # INFLUX_USERNAME / INFLUX_PASSWORD only
# Values in .env.local override .env. Both files are gitignored; keep them mode 600.

# Source database: InfluxDB 1.8 behind a proxy that requires a client certificate
INFLUX_URL=https://tsdb.hottis.de
INFLUX_DATABASE=level
INFLUX_STATION_LABEL=Deilbach

# Client certificate and key for mutual TLS. Keep them outside the repo,
# e.g. in ~/.config/deilbach-pegel/ (folder mode 700, key mode 600).
INFLUX_CLIENT_CERT=
INFLUX_CLIENT_KEY=

# Request timeout in seconds
INFLUX_TIMEOUT=30

# Read-only credentials. Put real values in .env.local, never here.
INFLUX_USERNAME=
INFLUX_PASSWORD=
